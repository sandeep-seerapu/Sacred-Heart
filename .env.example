# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://user:password@localhost:5432/hms_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hms_db

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production_12345
JWT_EXPIRES_IN=7d

# Email Notification Server (Nodemailer config)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hospital_email@gmail.com
SMTP_PASS=your_app_specific_password

# Client Settings (Vite dev proxy setup)
VITE_API_BASE_URL=http://localhost:5000/api
